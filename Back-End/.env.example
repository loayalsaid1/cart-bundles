# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Salla OAuth app
# Get from: Salla Partners Dashboard → App → OAuth credentials
SALLA_CLIENT_ID=your-client-id
SALLA_CLIENT_SECRET=your-client-secret
SALLA_APP_ID=your-app-id

# Salla webhook verification
# Get from: Salla Partners Dashboard → App → Webhooks → Signing Secret
SALLA_WEBHOOK_SECRET=your-webhook-secret

# Local JWT for the embedded app session
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# Allowed CORS origins (comma-separated)
# Frontend app origin + Salla storefront origins calling public recommendation endpoints
ALLOWED_CORS_ORIGINS=http://localhost:3000,https://demostore.salla.sa
