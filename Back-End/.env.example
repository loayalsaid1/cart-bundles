# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis — used for Salla catalog cache, merchant tokens, and stream queues
REDIS_URL=redis://localhost:6379

# Salla OAuth app
# Get from: Salla Partners Dashboard → App → OAuth credentials
SALLA_CLIENT_ID=your-client-id
SALLA_CLIENT_SECRET=your-client-secret
SALLA_APP_ID=your-app-id

# Salla webhook verification
# Get from: Salla Partners Dashboard → App → Webhooks → Signing Secret
SALLA_WEBHOOK_SECRET=your-webhook-secret

# Salla OAuth 2.0 (Custom Mode) — standalone login on the app's own domain
# Must EXACTLY match the Callback URL registered in Salla Partners → App → OAuth
# (Custom Mode). Note: locale-prefixed because the frontend routes are.
SALLA_REDIRECT_URI=http://localhost:3000/ar/login/callback
# Easy Mode still requires these scopes so catalog/special-offer APIs work.
# Also subscribe webhooks in Partners Portal (see SALLA.md).
SALLA_OAUTH_SCOPE=offline_access products.read_write categories.read coupons.read specialoffers.read_write webhooks.read_write

# Local JWT for the embedded app session
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# Allowed CORS origins (comma-separated)
# Frontend app origin. Any *.salla.sa storefront is also allowed in code.
ALLOWED_CORS_ORIGINS=http://localhost:3000,https://frontend-dev.cartbundles.com

# Admin seed only (pnpm db:seed-admin). Not read by login at runtime.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
